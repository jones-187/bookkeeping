{
  "name": "bookkeeping-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest --runInBand",
    "test:e2e": "maestro test --debug-output ../../tests/e2e/debug --test-output-dir ../../tests/e2e/results ../../tests/e2e/flows",
    "test:e2e:ci": "maestro test --format junit --debug-output ../../tests/e2e/debug --test-output-dir ../../tests/e2e/results ../../tests/e2e/flows",
    "test:e2e:web": "playwright test",
    "test:e2e:web:ui": "playwright test --ui",
    "test:e2e:web:debug": "playwright test --debug"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@hookform/resolvers": "^5.2.2",
    "@react-navigation/native": "6",
    "@react-navigation/native-stack": "6",
    "expo": "~51.0.28",
    "expo-sqlite": "~14.0.6",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.72.1",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "^2.31.0",
    "react-native-paper": "^5.15.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "~3.31.1",
    "react-native-web": "~0.19.10",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.7.2",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.79",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~7.1.1",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.6.3"
  }
}
