{
  "name": "bookkeeping-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage --collectCoverageFrom='src/**/*.{ts,tsx}'",
    "build": "npm run build:android && npm run build:ios",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "test:e2e": "maestro test --debug-output ../../tests/e2e/debug --test-output-dir ../../tests/e2e/results ../../tests/e2e/flows/test-suite.yaml",
    "test:e2e:ci": "maestro test --format junit --debug-output ../../tests/e2e/debug --test-output-dir ../../tests/e2e/results ../../tests/e2e/flows/test-suite.yaml"
  },
  "dependencies": {
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.8.6",
    "expo": "~57.0.8",
    "expo-asset": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "~22.13.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
